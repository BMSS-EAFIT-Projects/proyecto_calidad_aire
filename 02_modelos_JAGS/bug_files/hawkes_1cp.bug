data {
  for (k in 1:K) {
    dummy[k] <- 0
  }
}

model {

  # -----------------------------------------------------------
  # Asignacion de segmento para cada evento d[k]
  # J[k] = 1 si d[k] < tau[1]
  # J[k] = 2 si d[k] >= tau[1]
  # step(x) = 1 si x >= 0, 0 si x < 0
  # El -0.5 maneja el caso borde cuando d[k] cae exactamente en tau
  # -----------------------------------------------------------
  for (k in 1:K) {
    J[k] <- 1 + step(d[k] - tau[1] - 0.5)
  }

  # -----------------------------------------------------------
  # Recursion de Ozaki: A[k] = sum_{d_i < d_k} exp(-delta*(d_k - d_i))
  # Identica al modelo 0CP — delta es global en M1
  # -----------------------------------------------------------
  A[1] <- 0
  for (k in 2:K) {
    A[k] <- exp(-delta * (d[k] - d[k-1])) * (1 + A[k-1])
  }

  # -----------------------------------------------------------
  # Integral Weibull por segmentos — forma cerrada
  # Segmento 1: (tau[1]/beta[1])^alpha[1]
  # Segmento 2: (T/beta[2])^alpha[2] - (tau[1]/beta[2])^alpha[2]
  # Total: suma de ambas — se distribuye entre K eventos
  # -----------------------------------------------------------
  int_weibull_total <- pow(tau[1] / beta[1], alpha[1])
                     + pow(T / beta[2], alpha[2])
                     - pow(tau[1] / beta[2], alpha[2])

  # -----------------------------------------------------------
  # Log-verosimilitud via zeros trick
  # -----------------------------------------------------------
  for (k in 1:K) {

    phi[k] <- -log((alpha[J[k]] / beta[J[k]]) * pow(d[k] / beta[J[k]], alpha[J[k]] - 1)
                   + eta * A[k])
              + int_weibull_total / K
              + n * (1 - exp(-delta * (T - d[k])))
              + C

    dummy[k] ~ dpois(phi[k])

    phi2[k] <- log((alpha[J[k]] / beta[J[k]]) * pow(d[k] / beta[J[k]], alpha[J[k]] - 1)
                   + eta * A[k])
               - int_weibull_total / K
               - n * (1 - exp(-delta * (T - d[k])))
  }

  # -----------------------------------------------------------
  # Parametro derivado
  # -----------------------------------------------------------
  eta <- n * delta

  # -----------------------------------------------------------
  # Previas
  # -----------------------------------------------------------
  tau[1] ~ dunif(350, 600)

  for (j in 1:2) {
    alpha[j] ~ dunif(0, 3)
    beta[j]  ~ dunif(0, 100)
  }

  n     ~ dunif(0, 1)
  delta ~ dunif(0, 1)

}
